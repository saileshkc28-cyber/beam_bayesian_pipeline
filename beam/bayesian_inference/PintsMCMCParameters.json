{
    "problem_data": {
        "problem_name": "pints_mcmc_inference_beam",
        "echo_level": 1
    },
    "forward_model": {
        "primal_parameters_file": "PrimalParametersBayes.json",
        "sensor_data_file": "../sensor_placement/sensor_data.json"
    },
    "parameters": [
        {
            "name": "alpha_1",
            "control_variable": "YOUNG_MODULUS",
            "target_sub_model_part": "Structure.Beam_Auto1",
            "prior": {
                "type": "uniform",
                "parameters": [
                    0.2,
                    2.0
                ]
            }
        }
    ],
    "likelihood": {
        "measured_data_file": "../damaged_system/measured_data.csv",
        "noise_model": {
            "type": "gaussian_iid",
            "sigma": 3.77e-08
        }
    },
    "sampler_settings": {
        "python_module": "pints_metropolis_hastings_sampler",
        "Parameters": {
            "n_chains": 4,
            "burn_in": 500,
            "draws_per_chain": 1999,
            "proposal_std": [
                0.06
            ],
            "initial_states": [
                [
                    0.35
                ],
                [
                    0.75
                ],
                [
                    1.25
                ],
                [
                    1.75
                ]
            ],
            "random_seed": 20260822
        }
    },
    "output_processes": [
        {
            "python_module": "mcmc_posterior_output_process",
            "Parameters": {
                "output_path": "output_pints",
                "write_npz": true,
                "write_excel": true
            }
        },
        {
            "python_module": "mcmc_vtk_statistics_output_process",
            "Parameters": {
                "output_path": "output_pints/vtk_output",
                "output_file_name": "posterior_pints.vtk"
            }
        }
    ]
}
