{
    "forward_model": {
        "type": "kratos",
        "kratos": {
            "project_parameters_file": "PrimalParametersBayes.json",
            "self_check_on_init": true
        },
        "toy": {
            "metadata_file": "../damaged_system/measurement_metadata.json"
        }
    },
    "parameters": [
        {
            "name": "alpha_1",
            "control_variable": "YOUNG_MODULUS",
            "reference_value": 206900000000.0,
            "target_sub_model_part": "Structure.Beam_Auto1",
            "prior": {
                "type": "uniform",
                "parameters": [0.2, 2.0]
            }
        }
